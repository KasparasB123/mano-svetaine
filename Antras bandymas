<!DOCTYPE html>
<html lang="lt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Užsakymų žaidimas</title>
<style>
  body { font-family: Arial, Helvetica, sans-serif; color: #1a1a1a; background: #fff; margin: 0; line-height: 1.5; }
  .wrap { max-width: 640px; margin: 0 auto; padding: 0 20px; }

  header { border-bottom: 1px solid #ccc; padding: 14px 0; }
  header .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  h1 { font-size: 1.15rem; margin: 0; }
  .level { text-align: right; font-size: .9rem; }
  .bar { width: 160px; height: 6px; background: #e3e3e3; margin-top: 4px; margin-left: auto; }
  #xpfill { height: 100%; width: 0; background: #1f4fd8; transition: width .4s; }

  .notice { background: #f2f2f2; border-bottom: 1px solid #ccc; font-size: .85rem; padding: 8px 0; }

  h2 { font-size: 1rem; margin: 28px 0 8px; }
  .row { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e3e3e3; padding: 10px 0; }
  .price { margin-left: auto; margin-right: 16px; color: #555; }

  button { font: inherit; background: #1f4fd8; color: #fff; border: 0; border-radius: 3px; padding: 6px 14px; cursor: pointer; }
  button:hover { background: #173ca8; }
  button:disabled { background: #b5b5b5; cursor: default; }
  button.big { padding: 10px 18px; margin-top: 12px; }

  #cart { margin: 0; color: #333; }
  ol { list-style: none; padding: 0; margin: 0; }
  ol li { padding: 6px 0 6px 12px; border-left: 3px solid #e3e3e3; color: #888; }
  ol li.done { border-left-color: #1f4fd8; color: #1a1a1a; }
  ol li.now { font-weight: bold; }
  footer { height: 60px; }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <h1>Užsakymų žaidimas</h1>
    <div class="level">
      Lygis <span id="lvl">1</span>, <span id="xp">0</span> / 100 XP
      <div class="bar"><div id="xpfill"></div></div>
    </div>
  </div>
</header>

<div class="notice">
  <div class="wrap">Tai simuliacija. Tikras maistas nebus pristatytas ir mokėti nereikia.</div>
</div>

<main class="wrap">
  <h2>Meniu</h2>
  <div id="menu"></div>

  <h2>Krepšelis</h2>
  <p id="cart">Krepšelis tuščias.</p>
  <button class="big" id="order" disabled>Pateikti užsakymą</button>

  <h2>Užsakymo eiga</h2>
  <ol id="steps"></ol>
</main>
<footer></footer>

<script>
  // 1. Prekės (čia galima pridėti daugiau)
  const items = [
    { name: "Cepelinai su mėsa", price: 7.9 },
    { name: "Pica Margarita", price: 9.5 },
    { name: "Klasikinis burgeris", price: 7.5 },
    { name: "Suši rinkinys", price: 12.9 },
    { name: "Šaltibarščiai", price: 4.8 }
  ];
  const stepNames = ["Užsakymas priimtas", "Ruošiamas", "Kurjeris kelyje", "Pristatyta"];
  let cart = [];
  let xp = 0;

  // 2. Meniu
  document.getElementById("menu").innerHTML = items.map((it, i) =>
    `<div class="row"><span>${it.name}</span>
     <span class="price">${it.price.toFixed(2).replace(".", ",")} €</span>
     <button onclick="add(${i})">Pridėti</button></div>`).join("");

  // 3. Krepšelis
  function add(i) {
    cart.push(items[i]);
    const total = cart.reduce((s, it) => s + it.price, 0);
    document.getElementById("cart").textContent =
      cart.map(it => it.name).join(", ") + ". Iš viso: " + total.toFixed(2).replace(".", ",") + " €";
    document.getElementById("order").disabled = false;
  }

  // 4. Užsakymo eiga
  function showStep(n) {
    document.getElementById("steps").innerHTML = stepNames.map((s, i) =>
      `<li class="${i <= n ? "done" : ""} ${i === n ? "now" : ""}">${s}</li>`).join("");
  }
  showStep(-1);

  document.getElementById("order").onclick = function () {
    const count = cart.length;
    cart = [];
    document.getElementById("cart").textContent = "Krepšelis tuščias.";
    this.disabled = true;
    addXP(10 + count * 5);
    stepNames.forEach((s, i) => setTimeout(() => {
      showStep(i);
      if (i === 3) addXP(20);
    }, i * 4000));
  };

  // 5. XP ir lygiai (100 XP = 1 lygis)
  function addXP(n) {
    xp += n;
    document.getElementById("xp").textContent = xp % 100;
    document.getElementById("lvl").textContent = Math.floor(xp / 100) + 1;
    document.getElementById("xpfill").style.width = (xp % 100) + "%";
  }
</script>
</body>
</html>
